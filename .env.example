# Every setting the app reads, with plainly fake values. Real values are typed by the Owner into
# Netlify's environment settings and never go in this repository.

# Neon's pooled address, which the running site uses.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ruken
# Neon's direct address, which migrations use (the pooled one cannot run them).
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ruken
# How many connections one function instance may open. Optional; the default is 3.
# DATABASE_POOL_MAX=3

# Sign-in. The key signs session cookies and hashes the addresses the sign-in pause counts: long and random.
BETTER_AUTH_SECRET=test-only-secret-not-used-anywhere-real
# The site's own address, with https:// and no trailing slash.
BETTER_AUTH_URL=http://localhost:4173
# Where mail goes. `test:` sends nothing (used by the browser journeys).
SMTP_URL=test:
MAIL_FROM=Ruken <hello@ruken.test>
# Optional: comma-separated addresses. When set, only these get mail.
# MAIL_ALLOWLIST=
