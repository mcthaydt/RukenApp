# Every setting the app reads, with plainly fake values. Real values are typed by the Owner as secrets on the
# Worker in Cloudflare and never go in this repository.

# The running site reaches its database through Hyperdrive, a binding in wrangler.jsonc, not a setting.
# Neon's direct address, which the deploy command's migrations use (the pooled one cannot run them). In
# Workers Builds it is a build secret, read only by those migrations.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ruken
# How many connections one request may open. Optional; the default is 3.
# DATABASE_POOL_MAX=3

# Sign-in. The key signs session cookies and hashes the addresses the sign-in pause counts: long and random.
BETTER_AUTH_SECRET=test-only-secret-not-used-anywhere-real
# The site's own address, with https:// and no trailing slash.
BETTER_AUTH_URL=http://localhost:4173
# Resend's API key, for sending mail.
RESEND_API_KEY=re_test_fake
MAIL_FROM=Ruken <hello@ruken.test>
# Optional: comma-separated addresses. When set, only these get mail.
# MAIL_ALLOWLIST=

# The daily job's secret: the Worker's own daily trigger shows it to the site's job address, and anyone without it
# gets a 404. Long and random, and a different value from BETTER_AUTH_SECRET.
JOBS_SECRET=test-only-jobs-secret

# Money. Stripe's test-mode values everywhere except the real site. Real values are typed by the Owner
# into the site's secrets and never go in this repository.
STRIPE_SECRET_KEY=sk_test_fake
STRIPE_WEBHOOK_SECRET=whsec_test_fake
# "true" only on the real site, once Stripe is switched to live mode. The site refuses to start when
# this and the key's mode (sk_live_ or sk_test_) disagree.
STRIPE_LIVE=false
# Tests only: send every Stripe call to a stand-in at this address. Refused when STRIPE_LIVE=true.
# STRIPE_API_BASE=http://127.0.0.1:12111

# Games. The Ruken GitHub App's id and its private key (PEM), for pulling a maker's repository. The values here are
# fakes: the journeys make their own key, and the real ones are secrets on the real site.
GITHUB_APP_ID=42
GITHUB_APP_PRIVATE_KEY=test-only-not-a-key
# The same app's sign-in: its client id and secret (a maker connects their GitHub through it), and its short name from
# its address on GitHub (github.com/apps/<slug>). Fakes here; the real ones are secrets on the real site.
GITHUB_APP_CLIENT_ID=test-client
GITHUB_APP_CLIENT_SECRET=test-only-client-secret
GITHUB_APP_SLUG=ruken-test-app
# Tests only: send every GitHub call to a stand-in on this machine (the site refuses any other address).
# GITHUB_API_BASE=http://127.0.0.1:12112
# GITHUB_WEB_BASE=http://127.0.0.1:12112
# Where a game is played: one address with {name} as the first part of its name. Every game gets its own name under
# the games' domain, so it can never reach Ruken's cookies. https on the real site; plain http only for localhost.
GAME_ADDRESS_PATTERN=http://{name}.localhost:8788
# Play. The secret that signs the pass a browser loads a game with; the game gate (its own Worker) holds the same one and
# checks it. A fake here; the real one is a secret on both Workers. Never the sign-in secret.
PLAY_PASS_SECRET=test-only-play-pass-secret
