{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The game gate: a second Worker, so a game's files never come from Ruken's own address.
  "name": "ruken-games",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  // Node's crypto, for checking a play pass.
  "compatibility_flags": ["nodejs_compat"],
  // Until the games' domain exists, the gate answers on its own free Cloudflare address, with the game in the path
  // (the PATH_HOST setting says which host that is). When the Owner adds the domain's route, every game gets a name
  // of its own, and this goes back to false. The domain is not written here: this repository is public.
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // The same bucket the site writes to. The gate only reads it.
  "r2_buckets": [{ "binding": "GAME_FILES", "bucket_name": "ruken-games" }],
}
