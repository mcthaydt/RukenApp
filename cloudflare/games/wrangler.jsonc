{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The game gate: a second Worker, so a game's files never come from Ruken's own address.
  "name": "ruken-games",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  // Node's crypto, for checking a play pass.
  "compatibility_flags": ["nodejs_compat"],
  // The gate answers only on the games domain's route, every name under that domain, so each game has a name of its
  // own. The route is not written here, because this repository is public and never names the domain: the Owner
  // gives it as --route on every deploy of the gate. No free Cloudflare address beside it.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // The same bucket the site writes to. The gate only reads it.
  "r2_buckets": [{ "binding": "GAME_FILES", "bucket_name": "ruken-games" }],
}
