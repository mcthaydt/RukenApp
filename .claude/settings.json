{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": { "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "450000" },
  "permissions": {
    "allow": [
      "mcp__github__merge_pull_request",
      "mcp__github__disable_pr_auto_merge",
      "mcp__github__update_pull_request"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [{ "type": "command", "command": "cat \"$CLAUDE_PROJECT_DIR/.claude/after-compaction.md\"" }]
      },
      {
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/rules.mjs\"", "timeout": 10 }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|Agent|Workflow|mcp__.*",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/rules.mjs\"", "timeout": 30 }]
      },
      {
        "matcher": "^mcp__github__(merge_pull_request|disable_pr_auto_merge|update_pull_request)$",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/rules.mjs\"", "timeout": 30, "onFailure": "block" }]
      },
      {
        "matcher": "^mcp__github__create_pull_request$",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/rules.mjs\"", "timeout": 30, "onFailure": "block" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|mcp__.*",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/rules.mjs\"", "timeout": 15 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/rules.mjs\"", "timeout": 15 }]
      }
    ]
  }
}
