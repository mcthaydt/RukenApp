// The accounts feature's tables: sign-in, sessions, staff roles and "delete my account".
// User, Session, Account and Verification are better-auth's core tables, so their names and
// columns follow what better-auth reads and writes.

enum UserStatus {
  active
  /// The account asked to be deleted and can still undo it by signing in before its
  /// DeletionRequest's purgeAfter. Every read treats it like a signed-out stranger.
  pending_deletion
  deleted
}

enum StaffRole {
  owner
  curator
  support
  moderator
  /// A manager who decides on curation and review.
  head_curator
  /// A manager for money and billing screens.
  finance
}

model User {
  id            String     @id @default(cuid(2))
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  /// The sign-in. E.164: a "+" and 8 to 15 digits, one account for each. The column is named as better-auth's
  /// phone-number plugin reads it. A person who deleted their account has it set to null.
  /// SQL: CHECK "User_phoneNumber_check".
  phoneNumber         String?   @unique
  phoneNumberVerified Boolean   @default(false)
  /// When the person last typed a code that proved they hold the number. Null until they have.
  phoneConfirmedAt    DateTime? @db.Timestamptz
  /// The address a member pays with, kept for the few legal emails and for a reset code when Twilio cannot say the
  /// number is still theirs. Nobody types it into Ruken; checkout hands it over. Not the sign-in: `email` above is a
  /// stand-in for better-auth, which cannot do without one.
  paperEmail          String?
  image         String?
  status        UserStatus @default(active)
  /// The date of the 18th birthday, worked out once at sign-up. The birth date itself is
  /// never stored. Null means the age is unknown, and every under-18 default applies.
  adultOn       DateTime?  @db.Date
  /// Your feed's "Learn from what I do". Off, the feed treats the person like everyone else and keeps nothing new.
  feedPersonal  Boolean    @default(true)
  /// When the person last pressed Start over (or turned learning on again): nothing personal before it is read.
  feedResetAt   DateTime?  @db.Timestamptz
  createdAt     DateTime   @default(now()) @db.Timestamptz
  updatedAt     DateTime   @updatedAt @db.Timestamptz

  sessions         Session[]
  accounts         Account[]
  staffAssignments StaffAssignment[]
  deletionRequests DeletionRequest[]
  textsSent        TextSent[]
  computerKeys     ComputerKey[]
  computerSignIns  ComputerSignIn[]

  // The membership feature's tables point at a person; they are declared in membership.prisma.
  billingCustomer         BillingCustomer?
  premiumMembership       PremiumMembership?
  checkoutIntents         CheckoutIntent[]    @relation("CheckoutIntentPayer")
  broughtCheckouts        CheckoutIntent[]    @relation("CheckoutIntentMaker")
  membershipPayments      MembershipPayment[]
  membershipStarts        MembershipStart[]   @relation("MembershipStartMember")
  broughtMembershipStarts MembershipStart[]   @relation("MembershipStartMaker")

  // The games feature's tables point at a person; they are declared in games.prisma.
  games Game[]

  // The play feature's tables point at a person; they are declared in play.prisma.
  playPasses   PlayPass[]
  playSessions PlaySession[]

  // What GitHub said this person can reach; declared in games.prisma.
  githubInstallations GitHubInstallation[]

  // Staff decisions about games (games.prisma) and what a maker agreed to (make.prisma).
  gameReviews    GameReview[]   @relation("GameReviewStaff")
  makerAgreements MakerAgreement[]

  // The pages feature's table points at a person; it is declared in pages.prisma.
  makerPage MakerPage?

  // The launch feature's tables point at a person; they are declared in launch.prisma.
  wishlist     Wishlist[]
  wishlistMail WishlistMail?
  gameReports  GameReport[]

  // The feed feature's tables point at a person; they are declared in feed.prisma.
  feedTastes      FeedTaste[]     @relation("FeedTasteOwner")
  feedTastesOfMe  FeedTaste[]     @relation("FeedTasteMaker")
  goodPicksAsked  GoodPickAsked[]

  // The money feature's ledger lines name a maker; they are declared in money.prisma.
  journalLines JournalLine[]
  feePostings  FeePosting[]
  playDays     PlayDay[]

  // The money feature's pool shares and statements name a maker; they are declared in money.prisma.
  poolShares PoolShare[]
  statements Statement[]
}

model Session {
  id        String   @id @default(cuid(2))
  token     String   @unique
  expiresAt DateTime @db.Timestamptz
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid(2))
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz
  refreshTokenExpiresAt DateTime? @db.Timestamptz
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz
  updatedAt             DateTime  @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid(2))
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  @@index([identifier])
}

/// Staff roles. Rows are added and removed, never edited.
model StaffAssignment {
  id        String    @id @default(cuid(2))
  userId    String
  role      StaffRole
  createdAt DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, role])
}

/// Fixed-window request counters, in better-auth's `rateLimit` shape. `lastRequest` is epoch milliseconds.
model RateLimit {
  id          String @id @default(cuid(2))
  key         String @unique
  count       Int
  lastRequest BigInt
}

/// Failed password sign-ins per phone number. Ten failures inside an hour pause password sign-in for
/// that number for an hour. The key is a keyed hash of the number, not the user id: the
/// table also holds numbers with no account, so a pause looks the same for every number and no
/// stranger's number is stored in the clear. Rows expire by their own times (`windowStartedAt` + 1 h,
/// `pausedUntil`), so no job is needed for the rules to be right; a row that is long expired is
/// overwritten by the next failure and can be deleted at any time.
/// SQL: CHECK "SignInGuard_numberHash_check" requires 64 lower-case hex characters;
/// CHECK "SignInGuard_failures_check" requires at least 1.
model SignInGuard {
  numberHash      String    @id
  failures        Int
  windowStartedAt DateTime  @db.Timestamptz
  pausedUntil     DateTime? @db.Timestamptz
  createdAt       DateTime  @default(now()) @db.Timestamptz
  updatedAt       DateTime  @updatedAt @db.Timestamptz
}

/// A sign-up between its two screens: the password (already hashed) and the 18th birthday wait here for the code.
/// One row for each browser that started a sign-up for the number, so a stranger who starts one for someone's
/// number cannot change the password the real person's code then sets. Both keys are keyed hashes. Rows last ten
/// minutes. SQL: nothing but the key.
model PendingSignUp {
  numberHash   String
  browserHash  String
  passwordHash String
  adultOn      DateTime @db.Date
  expiresAt    DateTime @db.Timestamptz
  createdAt    DateTime @default(now()) @db.Timestamptz

  @@id([numberHash, browserHash])
}

/// A text sent to an account: one row for each person, kind and key, so the same notice is never sent twice. It holds
/// an id and no number, so it stays when the account is deleted. Added and never changed (trigger).
model TextSent {
  id         String   @id @default(cuid(2))
  userId     String
  kind       String
  key        String
  line       String
  providerId String?
  sentAt     DateTime @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, kind, key])
}

/// A person asked to delete their account. The account waits in pending_deletion for 14 days;
/// signing in before purgeAfter cancels it. The purge job tombstones the User and never deletes this row.
/// SQL: CHECK "DeletionRequest_window_check" (purgeAfter > requestedAt);
/// partial unique index "DeletionRequest_open_key" (one open request per user).
model DeletionRequest {
  id          String    @id @default(cuid(2))
  userId      String
  requestedAt DateTime  @db.Timestamptz
  purgeAfter  DateTime  @db.Timestamptz
  cancelledAt DateTime? @db.Timestamptz
  purgedAt    DateTime? @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([purgeAfter])
}

/// A computer a maker let act for them: the key it holds is kept only as its SHA-256 (`keyHash`), shown once at sign-in.
/// A key stops working when its row is deleted (removed, signed out, a changed or reset password, a deleted account) or
/// after 90 days unused. `lastUsedAt` is written at most once an hour.
model ComputerKey {
  id         String   @id @default(cuid(2))
  userId     String
  /// What the computer called itself, up to 60 characters; the maker can rename it.
  name       String
  keyHash    String   @unique
  createdAt  DateTime @default(now()) @db.Timestamptz
  lastUsedAt DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A sign-in code for ten minutes and one Yes. `userId` and `answer` stay null until the maker answers on Ruken.
/// `deviceSecretHash` is the SHA-256 of a secret only the terminal holds, so knowing the code alone never collects the
/// key. `startedFrom` is the city and country of the request that made it ({"city":..,"country":..} as text), shown beside
/// the Yes button.
model ComputerSignIn {
  id               String   @id @default(cuid(2))
  code             String   @unique
  deviceSecretHash String
  name             String
  startedFrom      String?
  userId           String?
  answer           String?
  expiresAt        DateTime @db.Timestamptz
  createdAt        DateTime @default(now()) @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}
