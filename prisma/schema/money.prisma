// The money feature's ledger: a double-entry journal and the months it is kept in, and the facts it is worked out
// from (payments posted, Stripe's fee report and what was placed from it, refunds and chargebacks, each day's play).
// Every one of these rows is a fact that is added and never changed, so a wrong entry is corrected by a new one (the
// add-only triggers are in the migrations).
// Amounts are whole cents in a BigInt; a debit is positive and a credit negative, so an entry's lines add up to zero.
//
// Prisma cannot express the CHECK rules or the triggers, so they are written by hand at the end of the migration and
// covered by tests/features/money/schema.pg.test.ts.

/// Where a month stands. It moves open, then closed, then final, and never back: a closed month takes no more facts
/// of its own (a late one is posted into the open month), and a final month takes no entry at all.
enum LedgerPeriodState {
  open
  closed
  final
}

/// What an entry is about. The posting functions in src/features/money/ name the kind of every entry they make.
enum JournalEntryKind {
  payment
  payment_fee
  release
  refund
  chargeback
  pool_share
  pool_carry
  transfer
  payout_cost
  correction
}

/// One calendar month in America/Chicago, written `YYYY-MM`. It is made the first time something posts into it.
/// CHECK: LedgerPeriod_period_check. Triggers: LedgerPeriod_forward_only.
model LedgerPeriod {
  period    String            @id
  state     LedgerPeriodState @default(open)
  closedAt  DateTime?         @db.Timestamptz
  finalAt   DateTime?         @db.Timestamptz
  createdAt DateTime          @default(now()) @db.Timestamptz

  entries    JournalEntry[]
  poolRun    PoolRun?
  statements Statement[]
}

/// One thing that happened to the money, with the lines that say where it went. Added and never changed.
/// Triggers: JournalEntry_append_only, JournalEntry_balances, JournalEntry_open_period.
model JournalEntry {
  id              String           @id @default(cuid(2))
  /// The same event posts once: a second try with this key and the same lines does nothing.
  idempotencyKey  String           @unique
  period          String
  kind            JournalEntryKind
  /// The payment (a Stripe invoice) the entry belongs to, when it has one.
  stripeInvoiceId String?
  gameId          String?
  /// The entry this one undoes, when it is a refund or a chargeback.
  reversesId      String?
  /// SHA-256 of the lines, so a repeat is told from the same key with other lines.
  linesHash       String
  createdAt       DateTime         @default(now()) @db.Timestamptz

  ledgerPeriod LedgerPeriod   @relation(fields: [period], references: [period], onDelete: Restrict)
  game         Game?          @relation(fields: [gameId], references: [id], onDelete: Restrict)
  reverses     JournalEntry?  @relation("EntryReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy   JournalEntry[] @relation("EntryReversal")
  lines        JournalLine[]

  @@index([period])
  @@index([stripeInvoiceId])
}

/// One line of an entry. A maker's line names the maker, and a maker's account is `maker:<id>:payable` and no other.
/// CHECK: JournalLine_maker_check. Triggers: JournalLine_append_only, JournalLine_balances.
model JournalLine {
  id          String   @id @default(cuid(2))
  entryId     String
  /// Where the money sits, such as `platform:revenue:premium` or `pool:premium:2026-11`.
  account     String
  makerUserId String?
  /// Whole cents: a debit is positive, a credit negative.
  amount      BigInt
  createdAt   DateTime @default(now()) @db.Timestamptz

  entry JournalEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  maker User?        @relation(fields: [makerUserId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@index([account])
}

/// How a Stripe fee report run stands. It moves from requested to stored or to failed, once.
enum FeeRunState {
  requested
  stored
  failed
}

/// What a line of Stripe's fee report was placed as: a fee of a payment (taken off the top), of a maker's payout, one
/// already counted from a balance transaction read before, one Stripe's credits paid, or one Stripe gave back.
enum FeeKind {
  payment
  payout
  counted
  credit
  returned
}

enum ReversalKind {
  refund
  chargeback_opened
  chargeback_won
  chargeback_lost
}

/// One payment that has been posted, with the three Stripe ids a fee in the report is placed by. Added and never
/// changed. Trigger: PaymentPosting_append_only.
model PaymentPosting {
  stripeInvoiceId       String   @id
  /// The month the payment's first part went to (the month it was posted into, which is not always its own).
  firstPeriod           String
  stripeChargeId        String   @unique
  stripePaymentIntentId String?  @unique
  /// The payment's own balance transaction, which the card fee was read from.
  balanceTransactionId  String   @unique
  postedAt              DateTime @db.Timestamptz
  createdAt             DateTime @default(now()) @db.Timestamptz

  payment MembershipPayment @relation(fields: [stripeInvoiceId], references: [stripeInvoiceId], onDelete: Restrict)
}

/// One stretch of time asked of Stripe for its fee report. The stretches never overlap. It is the one fact table that
/// moves: requested, then stored or failed, once (StripeFeeRun_forward_only). CHECK: StripeFeeRun_interval_check.
/// Trigger StripeFeeRun_no_overlap: no two runs that are not failed cover any of the same time; a failed run's stretch
/// is asked for again, so the start is not unique.
model StripeFeeRun {
  id                String      @id @default(cuid(2))
  intervalStart     DateTime    @db.Timestamptz
  intervalEnd       DateTime    @db.Timestamptz
  stripeReportRunId String      @unique
  state             FeeRunState @default(requested)
  rowCount          Int?
  /// Stripe's words, when the run failed.
  problem           String?
  requestedAt       DateTime    @db.Timestamptz
  storedAt          DateTime?   @db.Timestamptz
  createdAt         DateTime    @default(now()) @db.Timestamptz

  rows StripeFeeRow[]
}

/// One line of Stripe's fee report, exactly as Stripe wrote it: the amounts are decimal dollars and the times carry
/// no zone. Added and never changed. Trigger: StripeFeeRow_append_only.
model StripeFeeRow {
  id                   String @id @default(cuid(2))
  runId                String
  rowNumber            Int
  balanceTransactionId String
  balanceTransactionAt String
  feeTransactionId     String
  incurredBy           String
  incurredByType       String
  incurredAt           String
  product              String
  featureName          String
  description          String
  amountText           String
  taxText              String
  currency             String
  settledVia           String
  createdAt            DateTime @default(now()) @db.Timestamptz

  run     StripeFeeRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  posting FeePosting?

  @@unique([runId, rowNumber])
  @@index([incurredBy])
}

/// One report line that was placed. The amount is in millionths of a cent. Added and never changed.
/// CHECK: FeePosting_kind_check. Trigger: FeePosting_append_only.
model FeePosting {
  feeRowId        String   @id
  kind            FeeKind
  stripeInvoiceId String?
  makerUserId     String?
  microCents      BigInt
  postedAt        DateTime @db.Timestamptz
  createdAt       DateTime @default(now()) @db.Timestamptz

  feeRow StripeFeeRow @relation(fields: [feeRowId], references: [id], onDelete: Restrict)
  maker  User?         @relation(fields: [makerUserId], references: [id], onDelete: Restrict)
}

/// A refund or a dispute's step, as Stripe reported it. Added and never changed.
/// CHECK: StripeReversal_amounts_check. Trigger: StripeReversal_append_only.
model StripeReversal {
  /// Made in code: `refund:<Stripe's id>`, or `dispute:<Stripe's id>:opened`, `:won` or `:lost`.
  id                    String       @id
  kind                  ReversalKind
  stripeInvoiceId       String
  amountCents           BigInt
  /// Stripe's dispute fee; zero for a refund.
  feeCents              BigInt
  /// What Stripe gave back: a card fee with a refund, the money with a won dispute.
  returnedCents         BigInt
  balanceTransactionIds String[]
  at                    DateTime     @db.Timestamptz
  createdAt             DateTime     @default(now()) @db.Timestamptz
}

/// A day whose play was added up, even when nobody played. Added and never changed. Trigger: PlayDayRun_append_only.
model PlayDayRun {
  day      DateTime @id @db.Date
  rolledAt DateTime @db.Timestamptz
}

/// How long one person played one game on one Chicago day, at most three hours. Added and never changed.
/// CHECK: PlayDay_seconds_check. Trigger: PlayDay_append_only.
model PlayDay {
  id        String   @id @default(cuid(2))
  day       DateTime @db.Date
  userId    String
  gameId    String
  seconds   Int
  createdAt DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  game Game @relation(fields: [gameId], references: [id], onDelete: Restrict)

  @@unique([day, userId, gameId])
  @@index([day])
}

/// What a month's pool is shared by: the games' play, or the bringing bonus.
enum PoolShareKind {
  play
  bringing
}

/// What a line of a maker's statement is: a game's share, a bringing bonus, money sent to the maker's bank, what Stripe
/// charged for sending it, or a correction.
enum StatementLineSource {
  play
  bringing
  transfer
  payout_cost
  correction
}

/// The month's pool, shared once. `poolCents` is the makers' half as it stood, `carryCents` the part that moves on to
/// the next month (when members paid and nobody played), `members` how many members' money was in it, and
/// `inputsHash` a hash of what it was worked out from. Added and never changed. Trigger: PoolRun_append_only.
model PoolRun {
  period     String   @id
  poolCents  BigInt
  carryCents BigInt
  members    Int
  inputsHash String
  sharedAt   DateTime @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz

  ledgerPeriod LedgerPeriod @relation(fields: [period], references: [period], onDelete: Restrict)
  shares       PoolShare[]
}

/// One share of a month's pool: a game's (with its seconds of members' play) or a maker's bringing bonus (with the
/// members it is for). Added and never changed. CHECK: PoolShare_kind_check. Triggers: PoolShare_append_only. Partial
/// unique indexes, which Prisma cannot express: PoolShare_play_key (one play share for a game and a month) and
/// PoolShare_bringing_key (one bringing share for a maker and a month).
model PoolShare {
  id          String        @id @default(cuid(2))
  period      String
  kind        PoolShareKind
  makerUserId String
  gameId      String?
  weight      BigInt
  amountCents BigInt
  /// Members' counted play on the game that month, for a play share.
  seconds     Int?
  /// The members a bringing bonus is for.
  members     Int?
  createdAt   DateTime      @default(now()) @db.Timestamptz

  poolRun PoolRun @relation(fields: [period], references: [period], onDelete: Restrict)
  maker   User    @relation(fields: [makerUserId], references: [id], onDelete: Restrict)
  game    Game?   @relation(fields: [gameId], references: [id], onDelete: Restrict)

  @@index([makerUserId])
}

/// What one maker was shown for one month, as it was made final: the document, and a hash of it. Added and never
/// changed. Trigger: Statement_append_only.
model Statement {
  id          String   @id @default(cuid(2))
  makerUserId String
  period      String
  document    Json
  totalsHash  String
  createdAt   DateTime @default(now()) @db.Timestamptz

  maker        User            @relation(fields: [makerUserId], references: [id], onDelete: Restrict)
  ledgerPeriod LedgerPeriod    @relation(fields: [period], references: [period], onDelete: Restrict)
  lines        StatementLine[]

  @@unique([makerUserId, period])
}

/// One line of a statement, kept as a row so a maker's lines can be searched and questioned. Added and never changed.
/// Trigger: StatementLine_append_only.
model StatementLine {
  id          String              @id @default(cuid(2))
  statementId String
  source      StatementLineSource
  gameId      String?
  /// What the line is about, in the statement's own words' key: a game's slug, a payout's id, a correction's key.
  ref         String
  amountCents BigInt
  createdAt   DateTime            @default(now()) @db.Timestamptz

  statement Statement @relation(fields: [statementId], references: [id], onDelete: Restrict)
  game      Game?     @relation(fields: [gameId], references: [id], onDelete: Restrict)

  @@index([statementId])
}
