// The make feature's tables: what a maker has agreed to.
//
// Prisma cannot express the add-only trigger, so it is written by hand at the end of the migration and covered by
// tests/features/make/agreement.pg.test.ts.

/// The record of what a maker agreed to: which version of the maker agreement, and when. One row per maker and
/// version, so a new version is asked for again and the older rows stay. Added and never changed. It is kept when an account is purged, because it is the record of what a maker agreed to.
model MakerAgreement {
  id         String   @id @default(cuid(2))
  userId     String
  /// The version of the text that was accepted (`library/maker-agreement-v<n>.txt`).
  version    String
  acceptedAt DateTime @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, version])
}

/// What a maker did to their own game: took it off Ruken, or put it back (spec 13.1 M1 and M2). Added and never
/// changed, and kept when an account is purged, because it is the record of who did what to a game and when.
model MakerAction {
  id        String          @id @default(cuid(2))
  gameId    String
  userId    String
  action    MakerActionKind
  at        DateTime        @db.Timestamptz
  createdAt DateTime        @default(now()) @db.Timestamptz

  game Game @relation(fields: [gameId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([gameId])
}

enum MakerActionKind {
  taken_off
  put_back
}
