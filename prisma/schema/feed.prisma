// The feed feature's tables: what a person told the feed they want more or less of, and the Good pick questions it
// asked. Which rows exist is public on purpose (what a person is told is kept); how they move the order is private.

enum TasteDirection {
  more
  less
}

enum TasteKind {
  mood
  genre
  maker
  game
}

enum GoodPickAnswer {
  yes
  no
}

/// One chip on Your feed: more or less of a mood, a genre, a maker or a game. Pressing × deletes the row; Start over
/// deletes them all. `value` is the mood or genre word's key, or for a maker or a game its id, which is also in
/// `makerUserId` or `gameId` so the row goes with that person or game.
/// SQL: CHECK "FeedTaste_kind_columns" (a maker row names its maker, a game row its game, and the rest neither).
model FeedTaste {
  id          String         @id @default(cuid(2))
  userId      String
  direction   TasteDirection
  kind        TasteKind
  value       String
  makerUserId String?
  gameId      String?
  createdAt   DateTime       @db.Timestamptz

  user  User  @relation("FeedTasteOwner", fields: [userId], references: [id], onDelete: Cascade)
  maker User? @relation("FeedTasteMaker", fields: [makerUserId], references: [id], onDelete: Cascade)
  game  Game? @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, direction, kind, value])
  @@index([makerUserId])
  @@index([gameId])
}

/// A Good pick question the feed showed a person about a game, so it is asked once; `answer` is null until they press
/// Yes or No.
model GoodPickAsked {
  id      String          @id @default(cuid(2))
  userId  String
  gameId  String
  askedAt DateTime        @db.Timestamptz
  answer  GoodPickAnswer?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId])
}
