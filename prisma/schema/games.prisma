// The games feature's tables: a game, the files pulled from its maker's GitHub repository, and its clips.
// A game is untrusted code from a maker; nothing here holds a secret or a sign-in.
//
// Prisma cannot express the CHECK rules or the add-only trigger, so they are written by hand at the end of
// the migration and covered by tests/features/games/schema.pg.test.ts.

/// Where a game can be played. A phone is a browser whose User-Agent says so (play feature).
enum GamePlaysOn {
  phone_and_computer
  computer_only
}

/// How old a player should be to play (spec 10.5). Asked of the maker in the game's questions; staff may change it.
enum AgeRating {
  age_3
  age_7
  age_12
  age_16
  age_18
}

/// What an 18+ game contains (spec 12). `none` is the answer "None of these", so an empty list means "not asked yet".
enum ContentMark {
  sex_or_nudity
  gore
  drugs
  none
}

/// The parts of a game that staff can send back, and that a maker fixes one question at a time (spec 11.2).
enum GamePart {
  name
  one_line
  files
  plays_on
  upright_video
  wide_video
  age_rating
  other_websites
}

/// Where a game stands. `taken_off` is the maker's own doing; `taken_down` is staff's (a later slice). `thrown_away` is
/// a draft or sent-back game its maker threw away: the row stays (the money and the record may point at a game), but it
/// is in no list and its files are gone.
enum GameState {
  draft
  waiting
  live
  sent_back
  taken_off
  taken_down
  thrown_away
}

/// The two clips a game needs: one for a phone held upright and one for a wide screen.
enum ClipShape {
  upright
  wide
}

/// A game as its maker described it, and where it stands. `publicId` never changes (it names the game's own
/// address and its files, so a renamed game keeps its saves); `slug` is the page's address and may be made
/// again from a new name.
/// A game is answered one question at a time, so each answer is null until the maker gives it; Game_answered_check
/// holds every game past `draft` to having them all.
/// CHECKs: Game_publicId_check, Game_slug_check, Game_repoFolder_check, Game_live_check, Game_marks_check,
/// Game_answered_check, Game_held_check.
model Game {
  id            String        @id @default(cuid(2))
  publicId      String        @unique
  slug          String        @unique
  makerUserId   String
  name          String
  oneLine       String?
  playsOn       GamePlaysOn?
  state         GameState     @default(draft)
  /// Why staff took a game down, in their words (slice 4). Nothing writes it in slice 2: a game sent back says why
  /// in its `GameReviewPart` rows. Null in every other state.
  stateReason   String?
  /// Set by staff for a game that is free to everyone. False for every game until slice 4.
  freeToPlay    Boolean       @default(false)
  /// Whether the game's page says how many people played it this week. The maker's choice: off until they turn it on.
  showsPlayerCount Boolean    @default(false)
  /// `owner/name` on GitHub.
  repoFullName  String?
  /// Null: the repository's own default branch.
  repoBranch    String?
  /// The folder inside the repository that holds the built game; "" is the top.
  repoFolder    String        @default("")
  /// The servers the game talks to, as the maker listed them (`api.example.com`, five at most).
  connectHosts  String[]      @default([])
  /// Who the game is for. Null until the maker answers; a game past `draft` always has one.
  ageRating     AgeRating?
  /// What an 18+ game contains. Empty for any other rating, and until the maker answers.
  contentMarks  ContentMark[] @default([])
  /// A live game's new rating, waiting for staff's yes before players see it. Held together with `heldContentMarks`:
  /// either a rating is held with the marks that go with it, or nothing is. Null while nothing waits, and for any
  /// game that is not live (Game_held_check).
  heldAgeRating AgeRating?
  /// The marks that go with `heldAgeRating`: not empty when it is 18+, and empty otherwise.
  heldContentMarks ContentMark[] @default([])
  /// The parts staff sent back that the maker has not changed yet. Empty when nothing is waiting to be fixed.
  toFix         GamePart[]    @default([])
  /// The pull the game is live on. Set only while `state` is live.
  livePullId    String?       @unique
  /// The words of the last pull's refusal, for the game's page; null once a pull passes.
  pullProblem   String?
  /// The files waiting for a person's yes. A live game stays live on its old files until it is accepted.
  pendingPullId String?       @unique
  /// When those files were sent: the review queue's order, and its "sent 2 hours ago".
  pendingSince  DateTime?     @db.Timestamptz
  /// The last time the maker changed the game while it was waiting. A decision held for decision day applies only to
  /// the game as it was decided, so a change after it makes the decision lapse. Null until a maker changes one.
  changedAt     DateTime?     @db.Timestamptz
  /// When the maker saw the Accepted screen for this game. Null until they do; the decision days migration sets it for
  /// every game accepted before it, so only a game made live by a decision day shows that screen.
  acceptedSeenAt DateTime?    @db.Timestamptz
  createdAt     DateTime      @default(now()) @db.Timestamptz
  updatedAt     DateTime      @updatedAt @db.Timestamptz

  maker       User         @relation(fields: [makerUserId], references: [id], onDelete: Restrict)
  livePull    GamePull?    @relation("GameLivePull", fields: [livePullId], references: [id], onDelete: Restrict)
  pendingPull GamePull?    @relation("GamePendingPull", fields: [pendingPullId], references: [id], onDelete: Restrict)
  pulls       GamePull[]   @relation("GamePulls")
  clips       GameClip[]
  heldClips   GameHeldClip[]
  reviews     GameReview[]

  // The play feature's tables point at a game; they are declared in play.prisma.
  playPasses   PlayPass[]
  playSessions PlaySession[]

  // The launch feature's table points at a game; it is declared in launch.prisma.
  wishlist Wishlist[]
  reports  GameReport[]

  // The money feature's journal entries can name a game; they are declared in money.prisma.
  journalEntries JournalEntry[]
  playDays       PlayDay[]

  // The money feature's pool shares and statement lines can name a game; they are declared in money.prisma.
  poolShares     PoolShare[]
  statementLines StatementLine[]

  @@index([makerUserId])
}

/// One pull that passed its checks: a commit's files, copied into the bucket under this row's id. Added and
/// never changed, so what staff reviewed is what stays in the bucket (the add-only trigger is in the migration).
/// CHECKs: GamePull_commitSha_check, GamePull_counts_check.
model GamePull {
  /// Made in code, because the bucket's folder for these files is named by it before the row exists.
  id           String   @id
  gameId       String
  commitSha    String
  /// Measured from the pull; nobody types them.
  fileCount    Int
  totalBytes   BigInt
  /// The game's server list as it stood at this pull, so what staff reviewed is what runs.
  connectHosts String[]
  pulledAt     DateTime @db.Timestamptz
  createdAt    DateTime @default(now()) @db.Timestamptz

  game       Game         @relation("GamePulls", fields: [gameId], references: [id], onDelete: Restrict)
  liveFor    Game?        @relation("GameLivePull")
  pendingFor Game?        @relation("GamePendingPull")
  reviews    GameReview[]

  playPasses   PlayPass[]
  playSessions PlaySession[]

  @@index([gameId])
}

/// A game's clip of one shape. A new upload takes the old one's place (and gets its own address).
model GameClip {
  id          String    @id @default(cuid(2))
  gameId      String
  shape       ClipShape
  /// Where the video lives in the bucket: `clips/<publicId>/<shape>-<16 hex>.<mp4|webm>`.
  key         String    @unique
  contentType String
  bytes       Int
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  game Game @relation(fields: [gameId], references: [id], onDelete: Restrict)

  @@unique([gameId, shape])
}

/// A live game's new video, waiting for staff's yes before players see it. Players read only `GameClip`, so a held
/// video is never shown by a read that forgot a filter; the yes points the game's clip at this key and deletes the row.
/// A key is made as every clip's is, so it is unguessable and the media gate serves it as it serves a waiting game's.
/// CHECKs: GameHeldClip_key_check.
model GameHeldClip {
  id          String    @id @default(cuid(2))
  gameId      String
  shape       ClipShape
  /// Where the video lives in the bucket: `clips/<publicId>/<shape>-<16 hex>.<mp4|webm|mov>`.
  key         String    @unique
  contentType String
  bytes       Int
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  game Game @relation(fields: [gameId], references: [id], onDelete: Restrict)

  @@unique([gameId, shape])
}

/// One installation of the Ruken GitHub App that GitHub said a person can reach: asked of GitHub as that person
/// (never taken from an address, which anyone can type). A row means: GitHub said this person can reach this
/// installation. It is a person's data, so the account purge removes it.
model GitHubInstallation {
  id             String   @id @default(cuid(2))
  userId         String
  /// GitHub's own number for the installation.
  installationId BigInt
  /// The person or organisation the app is installed on.
  accountLogin   String
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  user         User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  repositories GitHubRepository[]

  @@unique([userId, installationId])
  @@index([userId])
}

/// One repository GitHub said a person can reach through one installation. A row means: GitHub said this person
/// can reach this repository through that installation.
model GitHubRepository {
  id            String   @id @default(cuid(2))
  connectionId  String
  /// `owner/name`.
  fullName      String
  defaultBranch String
  createdAt     DateTime @default(now()) @db.Timestamptz

  connection GitHubInstallation @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, fullName])
}

/// What staff decided about a game's files.
enum ReviewDecision {
  accepted
  sent_back
}

/// The record design 5.5 asks of every staff action: who, what, when. Added and never changed (the add-only trigger is
/// in the migration). A decision to send a game back says why in its `GameReviewPart` rows.
model GameReview {
  id          String         @id @default(cuid(2))
  gameId      String
  pullId      String
  staffUserId String
  decision    ReviewDecision
  decidedAt   DateTime       @db.Timestamptz
  /// The decision day a held decision goes out on. Null for a decision that took effect when it was made (an update
  /// to a live game, a game that was live before, and every review made before decision days). Set when the decision
  /// is made and never changed.
  goesOutOn   DateTime?      @db.Date
  createdAt   DateTime       @default(now()) @db.Timestamptz

  game    Game             @relation(fields: [gameId], references: [id], onDelete: Restrict)
  pull    GamePull         @relation(fields: [pullId], references: [id], onDelete: Restrict)
  staff   User             @relation("GameReviewStaff", fields: [staffUserId], references: [id], onDelete: Restrict)
  parts   GameReviewPart[]
  outcome DecisionOutcome?

  @@index([gameId])
}

/// One part of a game that staff sent back, and the reason they chose from that part's list (library/send-back-reasons.json).
/// Added and never changed (the add-only trigger is in the migration).
/// CHECKs: GameReviewPart_note_check.
model GameReviewPart {
  id        String   @id @default(cuid(2))
  reviewId  String
  part      GamePart
  /// The code of the reason, from that part's list; `something_else` stands for staff's own line in `note`.
  reason    String
  /// Staff's own line: required for `something_else`, optional beside any other reason; 1 to 500 characters.
  note      String?
  createdAt DateTime @default(now()) @db.Timestamptz

  review GameReview @relation(fields: [reviewId], references: [id], onDelete: Restrict)

  @@unique([reviewId, part])
}

/// What happened to a held decision on its decision day: `applied` took effect, `lapsed` did not because the maker
/// changed the game after it was decided.
enum DecisionResult {
  applied
  lapsed
}

/// A decision day that went out: one row per day, written when the day's held decisions took effect. A row means: this
/// day's decisions went out at this time, with this many seats. Added and never changed (the add-only trigger is in the
/// migration).
/// CHECKs: DecisionDay_seats_check.
model DecisionDay {
  id        String   @id @default(cuid(2))
  /// The decision day in its own time zone.
  day       DateTime @unique @db.Date
  /// The seats that day had, from the schedule at the time, so a later change to the schedule never rewrites a past week.
  seats     Int
  wentOutAt DateTime @db.Timestamptz
  createdAt DateTime @default(now()) @db.Timestamptz
}

/// What a decision day did with one held decision. Written only by the release, one per held decision of the day it
/// sends out. Added and never changed (the add-only trigger is in the migration).
model DecisionOutcome {
  id        String         @id @default(cuid(2))
  reviewId  String         @unique
  result    DecisionResult
  createdAt DateTime       @default(now()) @db.Timestamptz

  review GameReview @relation(fields: [reviewId], references: [id], onDelete: Restrict)
}
