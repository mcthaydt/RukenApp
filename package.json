{
  "name": "ruken",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.34.6+sha512.7e1ae66a83a9143c118cc1944f37cc4f2b8acddeda4b001cfa78908f6e46e45e15292739ca6c9d026426cc757e9318cc98c5551d6a16c165097b0028ba87b4e6",
  "scripts": {
    "dev": "vite dev",
    "generate": "svelte-kit sync && prisma generate",
    "build": "pnpm generate && vite build",
    "preview": "vite preview",
    "lint": "pnpm generate && eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm generate && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "pnpm generate && vitest run --project unit",
    "test:pg": "pnpm generate && vitest run --project postgres",
    "test:browser": "pnpm generate && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-netlify": "7.0.1",
    "@sveltejs/kit": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "eslint": "10.11.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "prisma": "7.10.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.23.1"
  }
}
