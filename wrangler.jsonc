{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The Worker's name. The Owner's empty Worker has the same name (S1), so the first deploy lands on it.
  "name": "ruken",
  // Written by `pnpm build` (SvelteKit's Cloudflare adapter). It stays the adapter's file because the adapter writes
  // its output to whatever `main` names; what is run and deployed is cloudflare/worker.js, which wraps this file and
  // adds the daily job. It is named on the command line: `pnpm run deploy` and the journeys' `wrangler dev`.
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-10-01",
  // Node's crypto, async_hooks and process.env, which sign-in and Prisma's driver need.
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
  // Until the Owner buys the site's domain, the site runs on its free workers.dev address (Owner, 2026-11-14: "Yes,
  // give me the commands to do it"). BETTER_AUTH_URL is set to that address. Once the custom domain is added in the
  // dashboard this goes back to false, so the custom domain is the one address. No preview addresses either way.
  "workers_dev": true,
  "preview_urls": false,
  // Cloudflare's Workers Logs keep request details (the address asked for, the country) beside what a Worker writes, and
  // Cloudflare's own pages do not say which of them stay with a plain console line. Ruken keeps nothing about a visitor
  // before they say yes to cookies (the owner, 2026-11-22), so the logs are off. Ruken's own error lines go unseen until
  // that is solved on its own.
  "observability": { "enabled": false },
  // Once a day, at 09:17 UTC, early morning in Chicago; and every hour, on the hour, which is when decision day goes
  // out (Friday noon New York time). cloudflare/crons.js says which jobs each one knocks on; the handler is in
  // cloudflare/worker.js.
  "triggers": { "crons": ["17 9 * * *", "0 * * * *"] },
  // Cloudflare's connection pool in front of Neon. The id names a setting in the Owner's account; it is not a
  // credential and is useless without the Owner's Cloudflare login (Owner, 2026-11-13: committed here).
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "eb64483c638e4f5eab2ce9dd1b7ea081" }],
  // Games and their clips (design 7.3). The Owner makes the bucket once, by hand, before this is deployed (a deploy
  // fails if it is missing); `wrangler dev` gives a local one and never reaches this one.
  "r2_buckets": [{ "binding": "GAME_FILES", "bucket_name": "ruken-games" }],
  // Cloudflare's media tool, which makes a video's still: one frame of a stored clip, shown in the video's place until it
  // plays (src/features/games/stills.ts). It has no local copy: `wrangler dev --local` gives a binding whose every call
  // throws ("needs to be run remotely"), so `wrangler dev` and the journeys run without stills, as a copy of the app does.
  "media": { "binding": "MEDIA" },
  // The deploy, and only the deploy (`pnpm run deploy` names it): the same Worker, plus PRIVATE, the private Worker
  // `ruken-private` (built from the private repo), which puts the feed in order over Workers RPC. `wrangler dev` and the
  // journeys read the top level and never see it, so a copy of the app runs on its own open order. Wrangler does not pass
  // bindings down to an environment, so each one above is repeated here, and `name` keeps the Worker the same one.
  "env": {
    "production": {
      "name": "ruken",
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "eb64483c638e4f5eab2ce9dd1b7ea081" }],
      "r2_buckets": [{ "binding": "GAME_FILES", "bucket_name": "ruken-games" }],
      "media": { "binding": "MEDIA" },
      "services": [{ "binding": "PRIVATE", "service": "ruken-private" }],
    },
  },
}
