{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The Worker's name. The Owner's empty Worker has the same name (S1), so the first deploy lands on it.
  "name": "ruken",
  // Written by `pnpm build` (SvelteKit's Cloudflare adapter). It stays the adapter's file because the adapter writes
  // its output to whatever `main` names; what is run and deployed is cloudflare/worker.js, which wraps this file and
  // adds the daily job. It is named on the command line: `pnpm run deploy` and the journeys' `wrangler dev`.
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-10-01",
  // Node's crypto, async_hooks and process.env, which sign-in and Prisma's driver need.
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
  // One address only: the custom domain the Owner adds in the dashboard. No workers.dev address, no preview addresses.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Once a day, at 09:17 UTC, early morning in Chicago. The handler is in cloudflare/worker.js.
  "triggers": { "crons": ["17 9 * * *"] },
  // Cloudflare's connection pool in front of Neon. The id names a setting in the Owner's account; it is not a
  // credential and is useless without the Owner's Cloudflare login (Owner, 2026-11-13: committed here).
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "eb64483c638e4f5eab2ce9dd1b7ea081" }],
  // Games and their clips (design 7.3). The Owner makes the bucket once, by hand, before this is deployed (a deploy
  // fails if it is missing); `wrangler dev` gives a local one and never reaches this one.
  "r2_buckets": [{ "binding": "GAME_FILES", "bucket_name": "ruken-games" }],
}
